# Kopiere diese Datei nach .env und passe sie an. Die Datei .env gehört nicht ins Repository (steht in .gitignore).

# Sprachmodell: mock (regelbasiert, ohne Schlüssel) oder gemini
LLM_PROVIDER=mock

# Nur für LLM_PROVIDER=gemini: Schlüssel aus Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=HIER_DEIN_SCHLUESSEL_EINTRAGEN
LLM_MODEL=gemini-2.5-flash
# Pause zwischen Modellaufrufen in Sekunden. Gratis-Kontingente haben enge Limits pro Minute.
LLM_MIN_INTERVAL=4

# Zugang für Prüfer (Freigaben, Audit-Log). Für alles außer einer lokalen Demo ändern!
REVIEWER_TOKEN=demo-reviewer

# Datenbank (nur für docker compose)
POSTGRES_PASSWORD=agent
